    {
      "id": 5,
      "title": "Throughput Temporal por Componente (Registros In)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 14,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "postgres-sismos"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgres-sismos"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ts AS time, SUM(CASE WHEN componente = 'spark' THEN registros_in END) AS \"Spark (In)\", SUM(CASE WHEN componente = 'nifi_feed' THEN registros_in END) AS \"NiFi Feed (In)\", SUM(CASE WHEN componente = 'nifi_historico' THEN registros_in END) AS \"NiFi Histórico (In)\" FROM sismos.metricas_pipeline WHERE $__timeFilter(ts) GROUP BY ts ORDER BY ts ASC;",
          "refId": "A"
        }
      ],
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "sum",
            "max",
            "mean"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          }
        },
        "overrides": []
      }
    },
