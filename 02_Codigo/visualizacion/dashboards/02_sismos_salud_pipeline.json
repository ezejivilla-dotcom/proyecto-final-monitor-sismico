    {
      "id": 8,
      "title": "Tasas de Éxito, Duplicados y Errores (última lectura)",
      "description": "Última lectura de nifi_feed (ventana móvil de 5 min), nifi_historico y spark (corrida completa)",
      "type": "table",
      "gridPos": {
        "x": 10,
        "y": 12,
        "w": 14,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "postgres-sismos"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgres-sismos"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT DISTINCT ON (componente) componente AS \"Componente\", registros_in AS \"Total In\", registros_ok AS \"Total OK\", registros_duplicados AS \"Total Duplicados\", registros_error AS \"Total Errores\", ROUND(registros_ok::numeric / NULLIF(registros_in, 0) * 100, 2) AS \"% Éxito\", ROUND(registros_duplicados::numeric / NULLIF(registros_in, 0) * 100, 2) AS \"% Duplicados\", ROUND(registros_error::numeric / NULLIF(registros_in, 0) * 100, 2) AS \"% Error\" FROM sismos.metricas_pipeline WHERE $__timeFilter(ts) ORDER BY componente, ts DESC;",
          "refId": "A"
        }
      ],
