    {
      "id": 7,
      "title": "Serie Temporal: Frecuencia Semanal y Energía Acumulada (Log10 Joules)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "postgres-sismos"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgres-sismos"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('week', fecha_evento) AS time, count(*) AS \"Frecuencia Semanal\", ROUND(COALESCE(LOG(NULLIF(SUM(energia_joules), 0)), 0)::numeric, 2) AS \"Log10 Energía (J)\" FROM sismos.eventos WHERE $__timeFilter(fecha_evento) AND tipo_evento = 'earthquake' AND magnitud >= ${rango_magnitud} AND region IN (${region:sqlstring}) AND cluster_id::text IN (${cluster:sqlstring}) GROUP BY 1 ORDER BY 1;",
          "refId": "A"
        }
      ],
