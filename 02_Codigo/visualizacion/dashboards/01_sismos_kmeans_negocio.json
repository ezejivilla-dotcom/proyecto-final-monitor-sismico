    {
      "id": 9,
      "title": "Auditoría Detallada de Clústeres KMeans",
      "description": "Contraste entre sismos.clusters y agregaciones reales de sismos.eventos",
      "type": "table",
      "gridPos": {
        "x": 10,
        "y": 22,
        "w": 14,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "postgres-sismos"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgres-sismos"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT c.cluster_id AS \"Cluster ID\", ROUND(c.centro_lat::numeric, 2) AS \"Centroide Lat\", ROUND(c.centro_lon::numeric, 2) AS \"Centroide Lon\", c.n_eventos AS \"Total Base\", count(e.evento_id) AS \"Total Filtrado\", ROUND(c.magnitud_prom::numeric, 2) AS \"Mag Prom Base\", ROUND(COALESCE(avg(e.magnitud), 0)::numeric, 2) AS \"Mag Prom Filtrada\", ROUND(COALESCE(avg(e.profundidad_km) FILTER (WHERE NOT e.profundidad_fija), 0)::numeric, 1) AS \"Prof Real Prom (km)\", count(e.evento_id) FILTER (WHERE e.tsunami) AS \"Tsunamis\" FROM sismos.clusters c LEFT JOIN sismos.eventos e ON c.cluster_id = e.cluster_id AND $__timeFilter(e.fecha_evento) AND e.tipo_evento = 'earthquake' AND e.magnitud >= ${rango_magnitud} AND e.region IN (${region:sqlstring}) WHERE c.cluster_id::text IN (${cluster:sqlstring}) GROUP BY c.cluster_id, c.centro_lat, c.centro_lon, c.n_eventos, c.magnitud_prom ORDER BY c.cluster_id ASC;",
          "refId": "A"
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [],
        "footer": {
          "show": false,
          "enablePagination": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      }
    }
