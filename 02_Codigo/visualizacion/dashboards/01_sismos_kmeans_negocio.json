    {
      "id": 8,
      "title": "Comparativa de Clústeres KMeans (Modelo vs Filtrados)",
      "type": "barchart",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 10,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "postgres-sismos"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgres-sismos"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT 'Cluster ' || c.cluster_id::text AS \"Cluster\", c.n_eventos AS \"Eventos Modelo\", count(e.evento_id) AS \"Eventos Filtrados\" FROM sismos.clusters c LEFT JOIN sismos.eventos e ON c.cluster_id = e.cluster_id AND $__timeFilter(e.fecha_evento) AND e.tipo_evento = 'earthquake' AND e.magnitud >= ${rango_magnitud} AND e.region IN (${region:sqlstring}) WHERE c.cluster_id::text IN (${cluster:sqlstring}) GROUP BY c.cluster_id, c.n_eventos ORDER BY c.cluster_id ASC;",
          "refId": "A"
        }
      ],
      "options": {
        "orientation": "auto",
        "barWidth": 0.75,
        "groupWidth": 0.7,
        "stacking": "none",
        "showValue": "auto",
        "xField": "Cluster",
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
